{
  "name": "@temporal-contract/client",
  "version": "8.0.0-beta.6",
  "description": "Client utilities with unthrown Result/AsyncResult for consuming temporal-contract workflows",
  "keywords": [
    "client",
    "contract",
    "result",
    "temporal",
    "typescript",
    "unthrown"
  ],
  "homepage": "https://github.com/btravstack/temporal-contract#readme",
  "bugs": {
    "url": "https://github.com/btravstack/temporal-contract/issues"
  },
  "license": "MIT",
  "author": "Benoit TRAVERS <benoit.travers.fr@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/btravstack/temporal-contract.git",
    "directory": "packages/client"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "build:docs": "typedoc",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "@temporal-contract/contract": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@btravstack/tsconfig": "catalog:",
    "@btravstack/typedoc": "catalog:",
    "@temporal-contract/testing": "workspace:*",
    "@temporalio/client": "catalog:",
    "@temporalio/common": "catalog:",
    "@temporalio/worker": "catalog:",
    "@temporalio/workflow": "catalog:",
    "@types/node": "catalog:",
    "@unthrown/vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typescript": "catalog:",
    "unthrown": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@temporalio/client": "^1.16.0",
    "@temporalio/common": "^1.16.0",
    "unthrown": "^5.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
