{
  "name": "@temporal-contract/contract",
  "version": "8.0.0-beta.4",
  "description": "Contract builder for temporal-contract",
  "keywords": [
    "contract",
    "temporal",
    "typescript"
  ],
  "homepage": "https://github.com/btravstack/temporal-contract#readme",
  "bugs": {
    "url": "https://github.com/btravstack/temporal-contract/issues"
  },
  "license": "MIT",
  "author": "Benoit TRAVERS <benoit.travers.fr@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/btravstack/temporal-contract.git",
    "directory": "packages/contract"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./errors": {
      "types": "./dist/errors.d.mts",
      "import": "./dist/errors.mjs"
    },
    "./result-async": {
      "types": "./dist/result-async.d.mts",
      "import": "./dist/result-async.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/errors.ts src/result-async.ts --format esm --dts --clean",
    "build:docs": "typedoc",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "dev": "tsdown src/index.ts src/errors.ts src/result-async.ts --format esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@btravstack/tsconfig": "catalog:",
    "@btravstack/typedoc": "catalog:",
    "@types/node": "catalog:",
    "@unthrown/vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "arktype": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typescript": "catalog:",
    "unthrown": "catalog:",
    "valibot": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "unthrown": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "unthrown": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
