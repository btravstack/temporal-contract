{
  "name": "@temporal-contract/testing",
  "version": "6.1.0",
  "description": "Temporal testing utilities",
  "keywords": [
    "contract",
    "temporal",
    "testcontainers",
    "testing",
    "typescript",
    "vitest"
  ],
  "homepage": "https://github.com/btravstack/temporal-contract#readme",
  "bugs": {
    "url": "https://github.com/btravstack/temporal-contract/issues"
  },
  "license": "MIT",
  "author": "Benoit TRAVERS <benoit.travers.fr@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/btravstack/temporal-contract.git",
    "directory": "packages/testing"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./extension": {
      "types": "./dist/extension.d.mts",
      "import": "./dist/extension.mjs"
    },
    "./global-setup": {
      "types": "./dist/global-setup.d.mts",
      "import": "./dist/global-setup.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/global-setup.ts src/extension.ts --format esm --dts --clean",
    "build:docs": "typedoc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "testcontainers": "catalog:"
  },
  "devDependencies": {
    "@temporal-contract/tsconfig": "workspace:*",
    "@temporal-contract/typedoc": "workspace:*",
    "@temporalio/client": "catalog:",
    "@temporalio/worker": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@temporalio/client": "^1",
    "@temporalio/worker": "^1",
    "vitest": "^4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
